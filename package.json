{
  "name": "@beakpoint/wingman",
  "version": "0.1.0",
  "description": "AI-assisted Beakpoint integration CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "beakpoint-wingman": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/templates dist/templates && cp src/tags/tags.json dist/tags/tags.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "docs": "typedoc --entryPoints src/index.ts --out docs/api"
  },
  "keywords": [
    "beakpoint",
    "opentelemetry",
    "instrumentation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beakpoint-Insights/Wingman.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.2",
    "chalk": "^5.6.2",
    "clipboardy": "^5.3.1",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  }
}
